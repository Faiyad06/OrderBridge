# Copy to .env (git-ignored) and fill in locally. Never commit real values or paste them into a chat.
# Live in-app agent (optional). Without it the app runs fully in labelled Rule-based replay mode.
ANTHROPIC_API_KEY=your-api-key-here
# Model identifier used by the server-side adapter (verify against https://platform.claude.com/docs before changing)
ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback: "default" (beta header server-side-fallback-2026-07-01) or "off"
ANTHROPIC_FALLBACKS=default
# Local demo login password for the three seeded synthetic accounts
ORDERBRIDGE_DEMO_PASSWORD=change-me-locally
# Optional overrides
# ORDERBRIDGE_DB=/absolute/path/to/orderbridge.sqlite3
# ORDERBRIDGE_SECURE_COOKIES=1        # set when served over HTTPS
# ORDERBRIDGE_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
